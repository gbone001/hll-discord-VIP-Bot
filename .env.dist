# Frontline Pass environment example
# Usage:
# 1. Copy this file to .env when you want environment-based configuration.
# 2. Fill in the required values below.
# 3. Leave optional values blank unless you need the related feature.
# 4. The bot also reads config.jsonc; environment variables override file values.

# Optional config-file location override.
# Set this only when config.jsonc lives outside the repository root.
FRONTLINE_CONFIG_PATH=

# Optional runtime state directory.
# In Docker or Railway, set this to a mounted volume such as /data so limiter state survives restarts.
FRONTLINE_STATE_DIR=
# Required core bot settings
DISCORD_TOKEN=
CHANNEL_ID=
VIP_DURATION_HOURS=4
LOCAL_TIMEZONE=Australia/Sydney

# Required CRCON HTTP settings
# Example base URL: https://crcon.example.com:8010
# Do not include /api; the bot appends it automatically.
CRCON_HTTP_BASE_URL=

# Choose one authentication method:
# Option A: bearer token
CRCON_HTTP_BEARER_TOKEN=

# Optional CRCON HTTP tuning
CRCON_HTTP_VERIFY=true
CRCON_HTTP_TIMEOUT=20

# Optional persistent announcement message reuse
# Set these if you want the bot to edit an existing control-panel message instead of posting a new one.
ANNOUNCEMENT_MESSAGE_ID=
QUICK_VIP_CHANNEL_ID=
QUICK_VIP_ANNOUNCEMENT_MESSAGE_ID=
QUICK_VIP_ROLE_IDS=

# Optional moderator permissions
# MODERATOR_ROLE_ID gates moderator/admin slash commands such as /assignvip and /game_server_message.
MODERATOR_ROLE_ID=

# Optional /assignvip support
# VIP_TEMP_ROLE_ID grants temporary access so a member can use the VIP claim flow.
# VIP_CLAIM_CHANNEL_ID is the channel where users should click Get VIP.
# If VIP_CLAIM_CHANNEL_ID is blank, the bot falls back to CHANNEL_ID.
VIP_TEMP_ROLE_ID=
VIP_CLAIM_CHANNEL_ID=
VIP_ASSIGN_LIMIT=5

# Optional slash command sync target
# For faster slash-command updates, set one or more guild IDs here.
# Use COMMAND_GUILD_IDS for comma-separated values, for example:
# COMMAND_GUILD_IDS=123456789012345678,987654321098765432
# Or set a single guild ID in COMMAND_GUILD_ID instead.
COMMAND_GUILD_IDS=
COMMAND_GUILD_ID=
